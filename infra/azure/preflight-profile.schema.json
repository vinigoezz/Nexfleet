{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexfleet.local/schemas/azure-preflight-profile.schema.json",
  "title": "NexFleet Azure preflight profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environmentName",
    "subscriptionId",
    "location",
    "staticWebLocation",
    "resourcePrefix",
    "resourceGroupName",
    "monthlyBudgetAmount",
    "billingCurrency",
    "budgetAlertEmails",
    "budgetThresholdPercent",
    "approvals"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "environmentName": { "enum": ["homolog"] },
    "subscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "location": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "staticWebLocation": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "resourcePrefix": { "type": "string", "pattern": "^[a-z0-9]{3,12}$" },
    "resourceGroupName": { "type": "string", "pattern": "^rg-[a-z0-9-]{3,40}$" },
    "monthlyBudgetAmount": { "type": "number", "exclusiveMinimum": 0 },
    "billingCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "budgetAlertEmails": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "email" }
    },
    "notificationRecipientEmail": {
      "description": "Destinatário do Azure Communication Services Email. Ausente ou vazio mantém captured-local.",
      "type": "string",
      "anyOf": [{ "const": "" }, { "format": "email" }]
    },
    "budgetThresholdPercent": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "integer", "minimum": 1, "maximum": 100 },
      "allOf": [
        { "contains": { "const": 50 } },
        { "contains": { "const": 80 } },
        { "contains": { "const": 100 } }
      ]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "billingScopeChecked",
        "spendingProtectionReviewed",
        "budgetConfigured",
        "paidResourcesApproved",
        "dataRegionApproved",
        "quotaReviewed",
        "backupPolicyApproved",
        "notificationProviderApproved"
      ],
      "properties": {
        "billingScopeChecked": { "type": "boolean" },
        "spendingProtectionReviewed": { "type": "boolean" },
        "budgetConfigured": { "type": "boolean" },
        "paidResourcesApproved": { "type": "boolean" },
        "dataRegionApproved": { "type": "boolean" },
        "quotaReviewed": { "type": "boolean" },
        "backupPolicyApproved": { "type": "boolean" },
        "notificationProviderApproved": { "type": "boolean" }
      }
    }
  }
}
