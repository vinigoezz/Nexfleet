# Modelo exclusivo para desenvolvimento local. Copie para .env.sprint0.
GATEWAY_PORT=8080

# O script Initialize-Local.ps1 substitui os marcadores abaixo por valores aleatórios.
JWT_SECRET=SUBSTITUA_POR_32_BYTES_ALEATORIOS_EM_BASE64
IDENTIDADE_DB_PASSWORD=SUBSTITUA_IDENTIDADE_DB_PASSWORD
FROTA_DB_PASSWORD=SUBSTITUA_FROTA_DB_PASSWORD
OPERACOES_DB_PASSWORD=SUBSTITUA_OPERACOES_DB_PASSWORD
INDICADORES_DB_PASSWORD=SUBSTITUA_INDICADORES_DB_PASSWORD
NOTIFICACOES_DB_PASSWORD=SUBSTITUA_NOTIFICACOES_DB_PASSWORD
RABBITMQ_USER=nexfleet
RABBITMQ_PASSWORD=SUBSTITUA_RABBITMQ_PASSWORD
RABBITMQ_CONNECTION=SUBSTITUA_RABBITMQ_CONNECTION

# Conta criada somente quando Start-Local.ps1 recebe -ProvisionUser.
LOCAL_USER_EMAIL=admin@nexfleet.local
LOCAL_USER_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL_FORTE
LOCAL_USER_PROFILE=ADMINISTRADOR

# Perfil normal depois do provisionamento inicial.
IDENTIDADE_PROFILES=jwt-rsa
